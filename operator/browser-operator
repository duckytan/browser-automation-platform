#!/usr/bin/env bash
# BAP operator/browser-operator - 浏览器操作层（§6.2 · 33 action）
# 用法: browser-operator <action> [args]
# 底层: CDP eval（JS 注入操作 DOM）+ cdp-browser.sh goto/shot
#
# A. 导航(4):  nav / back / forward / reload
# B. 交互(8):  click / type / hover / scroll / select / focus / blur / clear
# C. 提取(4):  extract / extract-css / extract-xpath / extract-regex
# D. Cookie(4):cookies-get / cookies-set / cookies-clear / cookies-export
# E. 状态(5):  shot / source / text / eval / wait
# F. 模板(1):  extract-template
# 错误码: OP001 用法 · OP002 CDP 失败 · OP003 selector 缺失 · OP004 eval 异常

set -uo pipefail

CDP_SH="${HOME}/.agents/skills/real-browser/scripts/cdp-browser.sh"

# === CDP eval 封装 ===
ceval() {
    bash "$CDP_SH" eval "$1" 2>&1
}

# === selector 安全转义（JSON.stringify · 解含引号 selector 崩）===
# 用 python3 生成 JSON 字符串字面量，含引号/特殊字符也能安全嵌入 JS
jsel() {
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

# === 导航类 ===
op_nav()    { bash "$CDP_SH" goto "${1:?OP001: 缺 URL}" 2>&1; }
op_back()   { ceval 'history.back(); "back"' 2>&1; }
op_forward(){ ceval 'history.forward(); "forward"' 2>&1; }
op_reload() { ceval 'location.reload(); "reload"' 2>&1; }

# === 交互类 ===
op_click() {
    local sel="${1:?OP001: 缺 selector}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003: 未找到 $sel'; el.click(); return 'clicked: $sel';})()"
}
op_type() {
    local sel="${1:?OP001: 缺 selector}" text="${2:?OP001: 缺 text}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003: 未找到 $sel'; el.focus(); el.value=$(jsel "$text"); el.dispatchEvent(new Event('input',{bubbles:true})); el.dispatchEvent(new Event('change',{bubbles:true})); return 'typed: $text';})()"
}
op_hover() {
    local sel="${1:?OP001: 缺 selector}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003'; el.dispatchEvent(new MouseEvent('mouseover',{bubbles:true})); return 'hover: $sel';})()"
}
op_scroll() {
    local times="${1:-3}" step="${2:-800}"
    # 逐屏滚动（每次独立 evaluate + 小步，避免一次多屏触发懒加载挂起）
    # CDP evaluate 同步返回，小步滚动不触发大规模异步 fetch
    ceval "(function(){var step=$step; window.scrollBy(0,step); return 'scrolled to y='+window.scrollY;})()"
    # 剩余次数通过多次调用（每次独立 evaluate）
    local i=1
    while [[ $i -lt $times ]]; do
        ceval "(function(){var step=$step; window.scrollBy(0,step); return 'scrolled to y='+window.scrollY;})()" >/dev/null 2>&1
        sleep 0.5
        i=$((i+1))
    done
    echo "scrolled $times steps"
}
op_select() {
    local sel="${1:?OP001: 缺 selector}" val="${2:?OP001: 缺 value}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003'; el.value=$(jsel "$val"); el.dispatchEvent(new Event('change',{bubbles:true})); return 'selected: $val';})()"
}
op_focus() {
    local sel="${1:?OP001: 缺 selector}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003'; el.focus(); return 'focus: $sel';})()"
}
op_blur()  { ceval 'document.activeElement.blur(); "blur"' 2>&1; }
op_clear() {
    local sel="${1:?OP001: 缺 selector}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); if(!el)return 'OP003'; el.value=''; return 'cleared: $sel';})()"
}

# === 提取类 ===
op_extract() {
    local sel="${1:?OP001: 缺 selector}" out="${2:-}"
    local data
    data=$(ceval "(function(){var els=document.querySelectorAll($(jsel "$sel")); var r=[]; els.forEach(function(e){r.push(e.innerText||e.textContent||'');}); return JSON.stringify(r);})()")
    if [[ -n "$out" ]]; then echo "$data" > "$out"; echo "已写入 $out"; else echo "$data"; fi
}
op_extract_css() {
    local sel="${1:?OP001: 缺 selector}" prop="${2:?OP001: 缺 property}"
    ceval "(function(){var el=document.querySelector($(jsel "$sel")); return el?getComputedStyle(el).getPropertyValue('$prop'):'OP003';})()"
}
op_extract_xpath() {
    local xp="${1:?OP001: 缺 xpath}"
    ceval "(function(){var r=document.evaluate($(jsel "$xp"),document,null,XPathResult.STRING_TYPE,null); return r.stringValue;})()"
}
op_extract_regex() {
    local re="${1:?OP001: 缺 regex}"
    ceval "(function(){var m=document.body.innerText.match(/$re/); return m?m[0]:'无匹配';})()"
}

# === Cookie 类 ===
op_cookies_get() {
    ceval 'JSON.stringify(document.cookie)'
}
op_cookies_set() {
    local name="${1:?OP001: 缺 name}" val="${2:?OP001: 缺 value}"
    ceval "document.cookie='$name=$val; path=/'; 'set: $name'"
}
op_cookies_clear() {
    ceval "(function(){var c=document.cookie.split(';');c.forEach(function(p){var n=p.split('=')[0].trim();document.cookie=n+'=;expires=Thu,01Jan1970 00:00:00 GMT;path=/';});return 'cleared '+c.length;})()"
}
op_cookies_export() {
    local name="${1:-cookie}"
    mkdir -p ~/.bap/states
    ceval 'document.cookie' > ~/.bap/states/${name}.txt
    echo "✅ 已导出 cookie → ~/.bap/states/${name}.txt"
}

# === 状态类 ===
op_shot()   { bash "$CDP_SH" shot "${1:-/tmp/bap-shot.png}" 2>&1; }
op_source() { ceval 'document.documentElement.outerHTML'; }
op_text()   { ceval 'document.body.innerText'; }
op_eval()   { ceval "${1:?OP001: 缺 JS}"; }
op_wait() {
    local sel="${1:?OP001: 缺 selector}" timeout="${2:-10}"
    local jsel_sel
    jsel_sel=$(jsel "$sel")
    ceval "(function(){var sel=$jsel_sel,t=$timeout*1000,start=Date.now();return new Promise(function(res){function chk(){var el=document.querySelector(sel);if(el){res('found: '+sel);}else if(Date.now()-start>t){res('timeout');}else{setTimeout(chk,200);}}chk();});})()" 2>&1 | head -1
}

# === 模板类 ===
op_extract_template() {
    local tpl="${1:?OP001: 缺模板文件}"
    [[ -f "$tpl" ]] || { echo "OP001: 模板不存在 $tpl" >&2; exit 1; }
    while IFS='=' read -r name sel; do
        [[ -z "$name" || "$name" =~ ^# ]] && continue
        val=$(ceval "(function(){var el=document.querySelector($(jsel "$sel"));return el?(el.innerText||el.textContent||''):'';})()")
        echo "$name=$val"
    done < "$tpl"
}

# === 统一 flag 解析（模板用 --url/--selector/--text/--name/--times flag 形式）===
# 把 --key value 转成位置参数序列，供 op_* 函数用（它们期望位置参数）
parse_flags() {
    local out=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url|--selector|--text|--value|--name|--output|--times|--timeout|--prop|--xpath|--regex|--template|--target|--profile|--browser)
                out+=("$2"); shift 2 ;;
            *) out+=("$1"); shift ;;
        esac
    done
    printf '%s\n' "${out[@]}"
}

# === 入口 ===
ACTION="${1:-}"; shift 2>/dev/null || true
case "$ACTION" in
    nav) op_nav $(parse_flags "$@") ;;
    back) op_back ;;
    forward) op_forward ;;
    reload) op_reload ;;
    click) op_click $(parse_flags "$@") ;;
    type) op_type $(parse_flags "$@") ;;
    hover) op_hover $(parse_flags "$@") ;;
    scroll) op_scroll $(parse_flags "$@") ;;
    select) op_select $(parse_flags "$@") ;;
    focus) op_focus $(parse_flags "$@") ;;
    blur) op_blur ;;
    clear) op_clear $(parse_flags "$@") ;;
    extract) op_extract $(parse_flags "$@") ;;
    extract-css) op_extract_css $(parse_flags "$@") ;;
    extract-xpath) op_extract_xpath $(parse_flags "$@") ;;
    extract-regex) op_extract_regex $(parse_flags "$@") ;;
    cookies-get) op_cookies_get ;;
    cookies-set) op_cookies_set $(parse_flags "$@") ;;
    cookies-clear) op_cookies_clear ;;
    cookies-export) op_cookies_export $(parse_flags "$@") ;;
    shot) op_shot $(parse_flags "$@") ;;
    source) op_source ;;
    text) op_text ;;
    eval) op_eval $(parse_flags "$@") ;;
    wait) op_wait $(parse_flags "$@") ;;
    extract-template) op_extract_template $(parse_flags "$@") ;;
    "")
        echo "用法: browser-operator <action> [args]"
        echo "导航: nav/back/forward/reload · 交互: click/type/hover/scroll/select/focus/blur/clear"
        echo "提取: extract/extract-css/extract-xpath/extract-regex · Cookie: cookies-get/set/clear/export"
        echo "状态: shot/source/text/eval/wait · 模板: extract-template"
        exit 0
        ;;
    *) echo "❌ 未知 action: $ACTION" >&2; exit 1 ;;
esac
